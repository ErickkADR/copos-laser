{
  "name": "copos-laser",
  "version": "1.0.0",
  "description": "Landing 3D de copos térmicos pretos com gravação a fibra laser: model-viewer + GSAP + Vite, textura de gravação gerada em canvas a partir de uma máscara.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "models:optimize": "node scripts/optimize-models.mjs",
    "art:build": "node scripts/build-art.mjs",
    "env:build": "node scripts/build-env.mjs",
    "images:capture": "node scripts/capture-cards.mjs http://localhost:5173",
    "images:optimize": "node scripts/optimize-images.mjs",
    "measure:lighthouse": "node scripts/lighthouse.mjs http://localhost:4173",
    "measure:runtime": "node scripts/measure-runtime.mjs http://localhost:4173",
    "measure:profile": "node scripts/profile.mjs http://localhost:4173",
    "models:convert": "node scripts/convert-dae.mjs"
  },
  "author": "Erick Dantas",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "gsap": "^3.15.1",
    "three": "~0.183.2"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@xmldom/xmldom": "^0.9.12",
    "lighthouse": "^13.6.0",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "svgo": "^3.3.2",
    "vite": "^8.3.8"
  }
}
